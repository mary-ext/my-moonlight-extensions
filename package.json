{
	"name": "my-moonlight-extensions",
	"private": true,
	"description": "mary's moonlight extensions",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://github.com/mary-ext/my-moonlight-extensions"
	},
