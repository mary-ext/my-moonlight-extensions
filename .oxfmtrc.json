{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"jsdoc": {
		"capitalizeDescriptions": false
	},
	"sortImports": {
		"groups": [
			["builtin", "bun"],

			["react"],

			["oomfware"],

			["external"],

			["moonlight-core"],
			{ "newlinesBetween": false },
			["moonlight-webpack"],

			["internal"],

			["parent"],

			["sibling", "index"]
		],
		"customGroups": [
			{
				"groupName": "bun",
				"elementNamePattern": ["bun", "bun:*"]
			},
			{
				"groupName": "react",
				"elementNamePattern": ["react", "react/**"]
			},
			{
				"groupName": "oomfware",
				"elementNamePattern": ["@mary/**", "@mary-ext/**", "@oomfware/**"]
			},
			{
				"groupName": "moonlight-core",
				"elementNamePattern": ["@moonlight-mod/**"]
			},
			{
				"groupName": "moonlight-webpack",
				"elementNamePattern": ["@moonlight-mod/wp/**"]
			}
		]
	},
	"overrides": [
		{
			"files": ["tsconfig*.json"],
			"options": { "parser": "jsonc" }
		},
		{
			"files": ["*.md"],
			"options": { "printWidth": 100, "proseWrap": "always" }
		}
	]
}
