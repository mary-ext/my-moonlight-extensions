{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"types": [],
		"moduleDetection": "force",
		"module": "preserve",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	}
}
